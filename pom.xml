<?xml version="1.0" encoding="UTF-8"?>
<!-- XML宣言: UTF-8エンコーディングで記述されたXMLファイルであることを定義 -->

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!-- project: XMLのルート要素。Mavenの設定仕様（名前空間やスキーマ）を定義 -->

    <!-- modelVersion: このpom.xmlが従っているPOMのバージョン（4.0.0で固定） -->
    <modelVersion>4.0.0</modelVersion>

   <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <!-- 4.1.0 から実在するバージョンへ変更してください -->
    <version>3.4.1</version>
    <relativePath/> <!-- lookup parent from repository -->
  </parent>

   <!-- groupId: 自分のプロジェクトのグループ識別名 -->
    <groupId>com.example</groupId>
    <!-- artifactId: 自分のプロジェクト名（生成される成果物の名称） -->
    <artifactId>bulletinboard</artifactId>
    <!-- version: 自分のプロジェクトのバージョン（-SNAPSHOTは開発中を示す） -->
    <version>0.0.1-SNAPSHOT</version>
    <!-- name: プロジェクトの表示用・管理用の名称 -->
    <name>bulletinboard</name>
    <!-- description: プロジェクトの詳細説明（現在は空） -->
    <description/>
    <!-- url: プロジェクトのWebサイトURL（現在は空） -->
    <url/>

    <!-- licenses: ライセンス情報をまとめるグループ -->
    <licenses>
        <!-- license: 個別のライセンス情報（現在は空） -->
        <license/>
    </licenses>

    <!-- developers: 開発者情報をまとめるグループ -->
    <developers>
        <!-- developer: 個々の開発者情報（現在は空） -->
        <developer/>
    </developers>

    <!-- scm: ソースコード管理（Git等）情報をまとめるグループ -->
    <scm>
        <!-- connection: 読み取り専用のSCM接続URL（現在は空） -->
        <connection/>
        <!-- developerConnection: 開発者用の書き込み可能SCM接続URL（現在は空） -->
        <developerConnection/>
        <!-- tag: リリース時のタグ名（現在は空） -->
        <tag/>
        <!-- url: Web上でコードを閲覧するためのURL（現在は空） -->
        <url/>
    </scm>

    <!-- properties: プロジェクト全体で共有する変数・プロパティの設定グループ -->
    <properties>
        <!-- java.version: 使用するJavaのバージョン指定（Java 21） -->
        <java.version>21</java.version>
    </properties>

    <!-- dependencies: プロジェクトに必要な外部ライブラリの一覧グループ -->
    <dependencies>
        <!-- dependency: Webアプリケーション構築用ライブラリ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>


        <!-- dependency: 開発時の自動再起動などの開発支援ツール -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <!-- scope: 実行時（runtime）のみ使用するスコープ指定 -->
            <scope>runtime</scope>
            <!-- optional: 他プロジェクトに継承させないオプション設定 -->
            <optional>true</optional>
        </dependency>

		<!-- （Thymeleaf）を使用するための設定 -->
		<dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

     <!-- 👇 共通レイアウト機能を有効化するために、これを追加します -->
        <dependency>
            <groupId>nz.net.ultraq.thymeleaf</groupId>
            <artifactId>thymeleaf-layout-dialect</artifactId>
        </dependency>


        <!-- ログイン時のみ表示）などのセキュリティタグを使う -->
        <dependency>
       <groupId>org.thymeleaf.extras</groupId>
       <artifactId>thymeleaf-extras-springsecurity6</artifactId>
      </dependency>

        <!-- dependency: Web機能のテスト用ライブラリ -->
        <!-- scope: テスト実行時（test）のみ使用するスコープ指定 -->
      <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
       <scope>test</scope>
    </dependency>

           <!-- バリデーション（@NotBlankなど）を使用するための設定 -->
       <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>


        <!-- Web機能・Security機能のテスト用ライブラリ -->
        <dependency>
        <groupId>org.springframework.security</groupId>
        <artifactId>spring-security-test</artifactId>
        <scope>test</scope>
       </dependency>


                <!-- Lombok本体（インポートを有効にするための設定） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>


        <!--  データベース操作を簡単にする(SQLを自動作成) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- 本番用データベース（MySQL） -->
                <!-- MySQL接続用ドライバー -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- テスト用の軽量データベース（H2） -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
       <!-- アプリにログイン機能やセキュリティ機能を書ける設定 -->
        <dependency>
         <groupId>org.springframework.boot</groupId>
         <artifactId>spring-boot-starter-security</artifactId>
      </dependency>

      <!-- ログイン状態を画面と連携させる設定 -->
     <dependency>
       <groupId>org.thymeleaf.extras</groupId>
       <artifactId>thymeleaf-extras-springsecurity6</artifactId>
     </dependency>

     <!-- 追記：Spring Boot のメール機能を利用 -->
     <dependency>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-mail</artifactId>
   </dependency>

    </dependencies>

    <!-- build: ビルド（パッケージングや実行手順）に関する設定グループ -->
    <build>
        <!-- plugins: ビルド時に使用する拡張機能（プラグイン）の一覧グループ -->
        <plugins>
            <!-- plugin: Spring Bootアプリの起動や実行可能JAR生成を行うプラグイン -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
			<!-- Lombok: ゲッターやセッターを自動生成するためのライブラリ -->
			<plugin>
			   <groupId>org.apache.maven.plugins</groupId>
               <artifactId>maven-compiler-plugin</artifactId>
			   <configuration>
            <annotationProcessorPaths>
             <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>1.18.36</version>
             </path>
           </annotationProcessorPaths>
       </configuration>
			</plugin>
        </plugins>
    </build>

</project>